# =========================================================
# SmartSearch AI Configuration
# =========================================================

# Google Gemini API Key for generative conversational RAG answers
# (Optional: if not provided or empty, SmartSearch AI falls back
# to grounded local extractive answers without requiring paid APIs)
GEMINI_API_KEY=

# Local Embedding Model (sentence-transformers)
# Default: all-MiniLM-L6-v2 (runs locally on CPU, no paid API required)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Hybrid Search Weights (must sum to ~1.0)
BM25_WEIGHT=0.50
SEMANTIC_WEIGHT=0.50

# Server Configuration
HOST=127.0.0.1
PORT=8000
